// Renovate config. Replaces Dependabot, which has no Typst ecosystem and so
// never bumped the `@preview/*` packages imported by the library.
// Requires the Renovate GitHub App (https://github.com/apps/renovate) to be
// installed on the repository; without it this file does nothing.
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    // Keep actions pinned to full commit SHAs (with the `# vX.Y.Z` comment
    // Renovate maintains), and pin any new tag reference on its first PR.
    'helpers:pinGitHubActionDigests',
  ],

  // Only these three. The Typst, FontAwesome and Lato versions live in the
  // Dockerfile, which the Makefile and CI read; they stay manual because a
  // bump needs the new image published and the fixtures regenerated in it
  // (`make docker-pdfs`). The typstyle and package-check pins have no such
  // coupling, so `custom.regex` tracks them below.
  enabledManagers: ['github-actions', 'typst', 'custom.regex'],

  customManagers: [
    {
      description: "build.yml's TYPSTYLE_VERSION, from typstyle's GitHub releases.",
      customType: 'regex',
      managerFilePatterns: ['/^\\.github/workflows/build\\.yml$/'],
      matchStrings: ['TYPSTYLE_VERSION: (?<currentValue>v\\S+)'],
      depNameTemplate: 'Enter-tainer/typstyle',
      datasourceTemplate: 'github-releases',
    },
    {
      description: "build.yml's PCHECK_IMAGE, the typst/packages checker image.",
      customType: 'regex',
      managerFilePatterns: ['/^\\.github/workflows/build\\.yml$/'],
      matchStrings: ['PCHECK_IMAGE: (?<depName>ghcr\\.io/typst/package-check):(?<currentValue>\\S+)'],
      datasourceTemplate: 'docker',
    },
  ],

  // Dependabot ran Sunday 22:00. Renovate schedules are windows (hour
  // granularity, and the hosted app runs roughly hourly), so open Sunday
  // night and run into early Monday to avoid a skipped week.
  timezone: 'Europe/Zurich',
  schedule: ['* 22-23 * * 0', '* 0-4 * * 1'],

  prConcurrentLimit: 5,
  labels: ['dependencies'],

  // Conventional commits: `chore(deps): …` by default (release-please does
  // not release on chore).
  semanticCommits: 'enabled',
  semanticCommitType: 'chore',
  semanticCommitScope: 'deps',

  packageRules: [
    {
      description: 'All GitHub Actions updates in one PR, as the Dependabot `actions` group did.',
      matchManagers: ['github-actions'],
      groupName: 'actions',
    },
    {
      // The @preview imports ship inside the published package and are pinned
      // to exact versions, so a bump only reaches users through a release.
      // `fix(deps)` makes release-please cut a patch release for it. Left
      // ungrouped: each bump can change rendered output (and so the committed
      // PDF fixtures), which is easier to review and regenerate per package.
      description: 'Typst package bumps change shipped code: release them as fixes.',
      matchManagers: ['typst'],
      semanticCommitType: 'fix',
    },
    {
      // CI-only, so nothing ships. A typstyle release that formats
      // differently fails the typstyle job on the bump PR: run `make fmt`
      // with the new version on that branch and commit the result (see
      // CONTRIBUTING). A package-check release that flags new issues fails
      // the package-check job the same way.
      description: 'typstyle and package-check bumps are CI changes.',
      matchDepNames: ['Enter-tainer/typstyle', 'ghcr.io/typst/package-check'],
      semanticCommitType: 'ci',
      semanticCommitScope: null,
    },
    {
      // template/cv.typ imports this package itself; its version is owned by
      // release-please (`x-release-please-version`).
      description: 'Never update the self-import of altacv.',
      matchManagers: ['typst'],
      matchDepNames: ['altacv'],
      enabled: false,
    },
  ],
}
