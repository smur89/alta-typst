// Navy section titles under a deeper name, the details a brighter
// cobalt so they don't sink into the ink; blue-leaning greys.

#let theme = (
  colours: (
    name: rgb("#13284A"),
    heading: rgb("#1A3A6C"),
    headingRule: rgb("#A3B5D1"),
    subheading: rgb("#2C5491"),
    accent: rgb("#2C5491"),
    emphasis: rgb("#1C2330"),
    body: rgb("#535C6B"),
    tagline: rgb("#1C2330"),
  ),
)
