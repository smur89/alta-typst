/// -> dictionary
#let palettes = (
  teal: rgb("#00796B"),
  navy: rgb("#1A3A6C"),
  crimson: rgb("#9E2A2B"),
  forest: rgb("#2E5E3A"),
  plum: rgb("#5F2A6E"),
  charcoal: rgb("#3B3B3B"),
)

